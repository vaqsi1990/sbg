

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @default("NO_NAME")
  email         String    @unique(map: "user_email_idx")
 clerkUserId   String
  password      String?
  role          String    @default("user")

  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt
  

}
enum ProductType {
  MATTRESS
  PILLOW
  QUILT
  PAD
  FURNITURE
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        ProductType
  images      String[]
  titleEn     String
  titleKa     String
  secondtext String
  secondtextEn String
  categoryEn  String
  categoryKa  String
  pad         Pad?
  mattress    Mattress?
  pillow      Pillow?
  quilt       Quilt?
  furniture   Furniture?
  catalogItems ProductCatalogItem[]
    createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt
}

enum CatalogKind {
  FEATURE
  HEIGHT
}

model CatalogItem {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        CatalogKind
  slug        String      @unique
  labelKa     String
  labelEn     String
  image       String
  href        String?
  legacyKey   String?     @unique
  forMattress Boolean     @default(true)
  forPad      Boolean     @default(true)
  sortOrder   Int         @default(0)
  products    ProductCatalogItem[]
  createdAt   DateTime    @default(now()) @db.Timestamp(6)
}

model ProductCatalogItem {
  productId String @db.Uuid
  itemId    String @db.Uuid
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  item      CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([productId, itemId])
}


model Mattress {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product         Product  @relation(fields: [id], references: [id], onDelete: Cascade)
  height          String
  size1           String?
  size2           String?
  firmnessLevel   Int      @default(0)
  descriptionEn String
  descriptionKa String
  minitext    String
  minitextEn  String
  springTech   Boolean
  breathable   Boolean
  doubleSided  Boolean
  orthopaedic  Boolean
  superSoftFoam Boolean @default(false)
  visconFabric Boolean @default(false)
  graphiteViscoFoam Boolean @default(false)
  carbonYarnTechnologyPillowTopMattress Boolean @default(false)
  middleComfortLayer Boolean @default(false)
  visconFabricSoftComfortLayer Boolean @default(false)
  copperViscoLayer Boolean @default(false)
  cncFoamTechnology Boolean @default(false)
  softComfortLayer Boolean @default(false)
  firmComfortLayer Boolean @default(false)
  aloeveraFabric Boolean @default(false)
  knitte       Boolean
  wool         Boolean
  visco        Boolean
  dns          Boolean
  latex        Boolean
  coconutLayer Boolean @default(false)
  washable     Boolean
}

model Pad {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product  Product  @relation(fields: [id], references: [id], onDelete: Cascade)
  firmness String
  firmnessEn String
  height   String

  descriptionEn String
  descriptionKa String
 minitext    String
  minitextEn  String
  springTech   Boolean
  breathable      Boolean
  doubleSided     Boolean
  orthopaedic     Boolean
  knitte Boolean
  wool Boolean
  visco Boolean
  dns Boolean
  latex Boolean
  coconutLayer Boolean @default(false)
 washable Boolean
}

model Pillow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product     Product  @relation(fields: [id], references: [id], onDelete: Cascade)
  size        String?
  weight      Int?
  minitext    String
  minitextEn  String
  outerFabric String
  filling     String
  packaging   String
  care        String   @default("")
  outerFabricEn String
  fillingEn     String
  packagingEn   String
  careEn        String   @default("")
}

model Quilt {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product       Product  @relation(fields: [id], references: [id], onDelete: Cascade)
  size1         String?
  size2         String?
  fabric        String   @default("")
  filling       String   @default("")
  fabricEn      String   @default("")
  fillingEn     String   @default("")
  weight        String   @default("")
  minitext      String   @default("")
  minitextEn    String   @default("")
  descriptionKa String   @default("")
  descriptionEn String   @default("")
}

model Furniture {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product         Product  @relation(fields: [id], references: [id], onDelete: Cascade)
  descriptionKa   String?
  descriptionEn   String?
  size1           String?
  size2           String?
  infoSections    Json?
}
